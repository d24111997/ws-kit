{
  // =========================================================================
  // ws-kit — VÍ DỤ THAM CHIẾU của config opencode (không phải thứ được cài)
  //
  // Đọc để biết hình dạng các khối; KHÔNG copy nguyên file vào máy:
  //   - providers/model ở đây gắn với account của người viết → phải remap
  //   - đường dẫn skills, host MCP, key… là của từng máy
  // Nguyên tắc + cần khối nào: docs/03-opencode-config.md
  // Secrets KHÔNG nằm trong file — dùng {env:VAR} / {file:path} (docs/04-secrets.md)
  // =========================================================================
  "$schema": "https://opencode.ai/config.json",

  // Model + agent mặc định (đổi provider/model theo account bạn connect — docs/04-secrets.md)
  "model": "opencode-go/deepseek-v4.1-flash",
  "default_agent": "jack",

  // ===== Providers =====
  "providers": {
    // --- OpenRouter (secret: OPENROUTER_API_KEY) ---
    "openrouter": {
      "env": ["OPENROUTER_API_KEY"],
      "models": {
        "deepseek/deepseek-v4": {
          "modelID": "deepseek/deepseek-v4-flash-latest",
          "name": "DeepSeek V4 Flash",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "limit": { "context": 600000, "output": 393216 },
          "settings": { "reasoningEffort": "high" },
          "body": { "thinking": { "type": "enabled" } },
          "compatibility": { "reasoningField": "reasoning_content" }
        }
      }
    },

    // --- CommandCode (secret: COMMANDCODE_API_KEY) ---
    "commandcode": {
      "name": "CommandCode",
      "package": "@opencode/ai/providers/openai-compatible",
      "env": ["COMMANDCODE_API_KEY"],
      "settings": { "baseURL": "https://api.commandcode.ai/provider/v1" },
      "models": {
        "deepseek/deepseek-v4": {
          "modelID": "deepseek/deepseek-v4-flash",
          "name": "DeepSeek V4 Flash",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "limit": { "context": 600000, "output": 393216 },
          "settings": { "reasoningEffort": "high" },
          "body": { "thinking": { "type": "enabled" } },
          "compatibility": { "reasoningField": "reasoning_content" }
        },
        "minimax/minimax-m3-free": {
          "modelID": "minimax/minimax-m3-free",
          "name": "MiniMax M3 (Free)",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 1000000, "output": 32768 },
          "body": { "thinking": { "type": "enabled" } },
          "compatibility": { "reasoningField": "reasoning_content" }
        }
      }
    },

    // --- Headroom proxy (local :8787 — xem docs/02-headroom.md) ---
    "headroom": {
      "name": "Headroom Proxy",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": { "baseURL": "http://127.0.0.1:8787/v1" }
    },

    // --- opencode-go (account connect — chứa model variants cho agents) ---
    // Variants giữ nguyên reasoning + temperature của bộ agent (xem docs/03-opencode-config.md).
    // Nếu bạn dùng provider khác → đổi model refs trong agents/ tương ứng.
    "opencode-go": {
      "models": {
        "deepseek-v4.1-flash": {
          "variants": [
            {
              "id": "high",
              "settings": { "reasoningEffort": "high" },
              "body": {
                "thinking": { "type": "enabled", "budgetTokens": 32000 },
                "temperature": 0.2
              }
            },
            {
              "id": "high-warm",
              "settings": { "reasoningEffort": "high" },
              "body": {
                "thinking": { "type": "enabled", "budgetTokens": 32000 },
                "temperature": 0.3
              }
            },
            { "id": "warm", "body": { "temperature": 0.3 } },
            { "id": "creative", "body": { "temperature": 0.4 } }
          ]
        }
      }
    }
  },

  // ===== Skills (trỏ thẳng thư mục skill trong clone kit — xem docs/03 §2) =====
  "skills": ["<đường-dẫn-thư-mục-skill>"],

  // ===== Permissions =====
  // v2: mảng rule, last-match-wins; `bash` đổi tên thành `shell`.
  // Base policy mặc định của v2 = allow-all (thêm external_directory ask + .env ask).
  "permissions": [
    { "action": "shell", "resource": "ssh *", "effect": "ask" },
    { "action": "shell", "resource": "git commit *", "effect": "ask" },
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "rtk git commit *", "effect": "ask" },
    { "action": "shell", "resource": "rtk git push *", "effect": "deny" }
  ],

  // ===== MCP servers =====
  // codemode: false — giữ tools native như v1 (serena_*, obsidian_*...)
  // Lý do + chi tiết: docs/03-opencode-config.md §Code Mode.
  "mcp": {
    "servers": {
      "tms": {
        // Task store (TMS) — MCP ghi qua HTTPS. Kit chỉ ship *hình dạng* config:
        // cần một instance TMS thật, xem docs/07-task-store.md.
        // Key không nằm trong repo và không đọc từ env (service có thể spawn
        // không có env — xem docs/04 §2), nên đọc từ file:
        //   printf '%s' '<key>' > ~/.secrets/tms-api-key && chmod 600 ~/.secrets/tms-api-key
        "type": "remote",
        "url": "https://<tms-host>/write/mcp",
        "oauth": false,
        "headers": { "Authorization": "Bearer {file:~/.secrets/tms-api-key}" },
        "codemode": false
      },
      "obsidian": {
        // Kit không dùng MCP Obsidian: agent đọc/ghi vault bằng filesystem.
        // Bật (xoá "disabled") nếu bạn vẫn muốn agent truy cập vault qua MCP.
        "disabled": true,
        "type": "local",
        "command": ["npx", "-y", "obsidian-mcp-server"],
        // obsidian-mcp-server 3.x dùng OBSIDIAN_BASE_URL (bỏ OBSIDIAN_HOST/OBSIDIAN_PORT).
        // Key đọc trực tiếp từ file ({file:}) để không phụ thuộc env của process service:
        //   echo -n "<key>" > ~/.secrets/obsidian-api-key && chmod 600 ~/.secrets/obsidian-api-key
        // (xem docs/04-secrets.md §2, docs/05-vault-setup.md §4-5)
        "environment": {
          "OBSIDIAN_API_KEY": "{file:~/.secrets/obsidian-api-key}",
          "OBSIDIAN_BASE_URL": "https://127.0.0.1:27124",
          "OBSIDIAN_VERIFY_SSL": "false"
        },
        "codemode": false
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx", "-y", "chrome-devtools-mcp@latest",
          "--autoConnect",
          "--no-category-performance",
          "--no-category-network"
        ],
        "codemode": false
      },
      "headroom": {
        "type": "local",
        "command": ["headroom", "mcp", "serve"],
        "codemode": false
      },
      "serena": {
        "type": "local",
        "command": [
          "uvx", "--from", "git+https://github.com/oraios/serena",
          "serena", "start-mcp-server",
          "--project-from-cwd",
          "--context", "ide",
          "--open-web-dashboard", "False"
        ],
        "codemode": false
      }
    }
  }
}
